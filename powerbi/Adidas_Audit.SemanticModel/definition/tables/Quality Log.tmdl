/// Every check run on the raw file, with the rows affected and the action taken.
table 'Quality Log'

	column check
		dataType: string
		summarizeBy: none
		sourceColumn: check

	column rows_affected
		dataType: int64
		formatString: #,0
		summarizeBy: none
		sourceColumn: rows_affected

	column finding
		dataType: string
		summarizeBy: none
		sourceColumn: finding

	column action
		dataType: string
		summarizeBy: none
		sourceColumn: action

	partition 'Quality Log' = m
		mode: import
		source = ```
				let
				    Source = Csv.Document(
				        Web.Contents(BaseUrl, [RelativePath = "data_quality_log.csv"]),
				        [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]
				    ),
				    #"Promoted Headers" = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    // empty cells and R's NA arrive as text and would fail the type change: make them null
				    #"Blanks to Null" = Table.TransformColumns(#"Promoted Headers", {}, each if _ = "" or _ = "NA" then null else _),
				    // True/TRUE/true all become true: pandas writes True, R writes TRUE
				    #"Booleans" = Table.TransformColumns(#"Blanks to Null", {}),
				    #"Changed Types" = Table.TransformColumnTypes(
				        #"Booleans",
				        {
				            {"check", type text},
				            {"rows_affected", Int64.Type},
				            {"finding", type text},
				            {"action", type text}
				        },
				        "en-US"
				    ),
				    #"Filtered Rows" = #"Changed Types",
				    Result = #"Filtered Rows"
				in
				    Result
				```

