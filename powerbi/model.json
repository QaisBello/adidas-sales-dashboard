    }
  ],
  "relationships": [],
  "measures": [
    {
      "name": "Selected Basis",
      "table": "Sales",
      "folder": "Switch",
      "format": "General",
      "dax": "SELECTEDVALUE ( Basis[Basis], \"Recomputed (price x units)\" )",
      "description": "The basis chosen in the slicer; recomputed when nothing is chosen."
    },
    {
      "name": "Sales Reported",
      "table": "Sales",
      "folder": "Sales",
      "format": "\\$#,0",
      "dax": "SUM ( Sales[sales_reported] )",
      "description": "Total sales as published in the dataset."
    },
    {
      "name": "Sales Recomputed",
      "table": "Sales",
      "folder": "Sales",
      "format": "\\$#,0",
      "dax": "SUM ( Sales[sales_recomputed] )",
      "description": "Price x units for every line."
    },
    {
      "name": "Total Sales",
      "table": "Sales",
      "folder": "Sales",
      "format": "\\$#,0",
      "dax": "IF ( [Selected Basis] = \"As reported\", [Sales Reported], [Sales Recomputed] )",
      "description": "Sales on the basis chosen in the slicer."
    },
    {
      "name": "Operating Profit",
      "table": "Sales",
      "folder": "Sales",
      "format": "\\$#,0",
      "dax": "IF ( [Selected Basis] = \"As reported\", SUM ( Sales[profit_reported] ), SUM ( Sales[profit_recomputed] ) )",
      "description": "Operating profit on the chosen basis (profit follows the inflated sales column)."
    },
    {
      "name": "Units Sold",
      "table": "Sales",
      "folder": "Sales",
      "format": "#,0",
      "dax": "SUM ( Sales[units_sold] )",
      "description": "Units sold."
    },
    {
      "name": "Overstatement",
      "table": "Sales",
      "folder": "Audit",
      "format": "0.0\"x\"",
      "dax": "DIVIDE ( [Sales Reported], [Sales Recomputed] )",
      "description": "Reported sales as a multiple of the recomputed figure."
    },
    {
      "name": "Lines",
      "table": "Sales",
      "folder": "Audit",
      "format": "#,0",
      "dax": "COUNTROWS ( Sales )",
      "description": "Invoice lines."
    },
    {
      "name": "Lines Inflated 10x",
      "table": "Sales",
      "folder": "Audit",
      "format": "#,0",
      "dax": "CALCULATE ( [Lines], Sales[flag_sales_x10] == TRUE () )",
      "description": "Lines whose reported sales are exactly 10 x price x units."
    },
    {
      "name": "Share of Lines Inflated",
      "table": "Sales",
      "folder": "Audit",
      "format": "0.0%",
      "dax": "DIVIDE ( [Lines Inflated 10x], [Lines] )",
      "description": "Share of lines carrying the 10x error."
    },
    {
      "name": "Channel Share",
      "table": "Sales",
      "folder": "Channels",
      "format": "0.0%",
      "dax": "DIVIDE ( [Total Sales], CALCULATE ( [Total Sales], REMOVEFILTERS ( Sales[sales_method] ) ) )",
      "description": "Share of sales by channel on the chosen basis."
    },
    {
      "name": "Channel Share Reported",
      "table": "Sales",
      "folder": "Channels",
      "format": "0.0%",
      "dax": "DIVIDE ( [Sales Reported], CALCULATE ( [Sales Reported], REMOVEFILTERS ( Sales[sales_method] ) ) )",
      "description": "Channel share as reported."
    },
    {
      "name": "Channel Share Recomputed",
      "table": "Sales",
      "folder": "Channels",
      "format": "0.0%",
      "dax": "DIVIDE ( [Sales Recomputed], CALCULATE ( [Sales Recomputed], REMOVEFILTERS ( Sales[sales_method] ) ) )",
      "description": "Channel share recomputed."
    },
    {
      "name": "Cities Selling",
      "table": "Sales",
      "folder": "Coverage",
      "format": "#,0",
      "dax": "DISTINCTCOUNT ( Sales[city_state] )",
      "description": "Cities with sales: 9 in 2020 against 47 in 2021, which is why year-on-year growth is not like-for-like."
    }
  ],
